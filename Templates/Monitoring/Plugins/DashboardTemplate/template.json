                                                    "titleKind": 2,
                                                    "visualization": {
                                                        "chartType": 3
                                                    },
                                                    "openBladeOnClick": {
                                                        "openBlade": true,
                                                        "destinationBlade": {
                                                            "bladeName": "ResourceMenuBlade",
                                                            "parameters": {
                                                                "id": "[variables('appInsightsId')]",
                                                                "menuid": "performance"
                                                            },
                                                            "extensionName": "HubsExtension",
                                                            "options": {
                                                                "parameters": {
                                                                    "id": "[variables('appInsightsId')]",
                                                                    "menuid": "performance"
                                                                }
                                                            }
                                                        }
                                                    }
