                                        {
                                            "name": "PartId",
                                            "value": "0ff27c23-2cb8-4e03-8814-d3abce56b707",
                                            "isOptional": true
                                        },
                                        {
                                            "name": "Version",
                                            "value": "2.0",
                                            "isOptional": true
                                        },
                                        {
                                            "name": "TimeRange",
