{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "pluginsDashboardName": {
            "defaultValue": "Plugins Dashboard (ENV)",
            "type": "string"
        },
        "appInsightsName": {
            "defaultValue": "ai-tenant-env",
            "type": "string"
        },
        "dataverseEnvironmentDesignation": {
            "defaultValue": "DEV",
            "type": "string"
        },
        "tenantPluginNamespace": {
            "defaultValue": "YourPluginNamespace",
            "type": "string"
        },
        "region": {
            "defaultValue": "West US",
            "type": "string"
        }
    },
    "variables": {
        "appInsightsId": "[resourceId('microsoft.insights/components', parameters('appInsightsName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Portal/dashboards",
            "apiVersion": "2022-12-01-preview",
            "name": "[format('{0}-{1}', parameters('pluginsDashboardName'), parameters('dataverseEnvironmentDesignation'))]",
            "location": "[parameters('region')]",
            "tags": {
                "hidden-title": "[format('{0}-{1}', parameters('pluginsDashboardName'), parameters('dataverseEnvironmentDesignation'))]"
            },
            "properties": {
                "lenses": [
                    {
                        "order": 0,
                        "parts": [
                            {
                                "position": {
                                    "x": 0,
                                    "y": 0,
                                    "rowSpan": 3,
                                    "colSpan": 4
                                },
                                "metadata": {
                                    "inputs": [
                                        {
                                            "name": "options",
                                            "value": {
                                                "chart": {
                                                    "metrics": [
                                                        {
                                                            "resourceMetadata": {
                                                                "id": "[variables('appInsightsId')]"
                                                            },
