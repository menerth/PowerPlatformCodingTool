                                            "value": "[format('dependencies\n| where type == \"Plugin\"\n| project timestamp, success, correlationId = customDimensions.correlationId, Plugin = customDimensions.pluginType, CustomValidation = customDimensions.stage == 10\n| where Plugin startswith \"{0}\" // filtering the OOB plugins\n| summarize NumberOfRequest = count(), Passed = dcountif(timestamp, success == \"True\"), Failed = dcountif(timestamp, success == \"False\") by tostring(Plugin), CustomValidation\n| extend SuccessRate = todecimal(100*Passed/(Passed + Failed))\n| order by CustomValidation desc, SuccessRate asc\n| limit 20', parameters('tenantPluginNamespace'))]",
                                            "isOptional": true
