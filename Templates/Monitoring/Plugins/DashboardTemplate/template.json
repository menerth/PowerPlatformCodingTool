                                            "value": {
                                                "xAxis": {
                                                    "name": "Namespace",
                                                    "type": "string"
                                                },
                                                "yAxis": [
                                                    {
                                                        "name": "ExecutionCount",
                                                        "type": "long"
                                                    },
                                                    {
                                                        "name": "AvgExecutionTime",
                                                        "type": "int"
                                                    },
                                                    {
                                                        "name": "percentile_executionTimeInMS_50",
                                                        "type": "real"
                                                    },
                                                    {
                                                        "name": "ExecutionTimeinMS_90",
                                                        "type": "real"
                                                    }
                                                ],
                                                "splitBy": [],
                                                "aggregation": "Sum"
                                            },
                                            "isOptional": true
                                        },
