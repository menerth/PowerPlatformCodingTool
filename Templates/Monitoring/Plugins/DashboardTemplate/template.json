                                            "isOptional": true
                                        },
                                        {
                                            "name": "DraftRequestParameters",
                                            "isOptional": true
                                        },
                                        {
                                            "name": "Query",
                                            "value": "[format('dependencies\r\n| where type == ''Plugin''\r\n| where name startswith \"{0}\" // filtering the OOB plugins\r\n| extend executionTimeInMS = todouble(duration)\r\n| extend cd = parse_json(customDimensions)\r\n| extend depth = toint(cd.depth)\r\n| where success == ''True''\r\n| summarize percentiles(executionTimeInMS, 10, 50, 90, 95, 98), NumOfRequests = count(), MaxDepth = max(depth), AvgExecutionTime= toint(avg(executionTimeInMS/1000)) by name\r\n| join kind = inner ( dependencies\r\n| summarize NumOfTotalRequests = count() by name ) on name\r\n| project-away name1\r\n| extend PassRate = todouble(NumOfRequests) * 100 / NumOfTotalRequests\r\n| extend PT95vsPT50Ratio = iif(percentile_executionTimeInMS_50 != 0, percentile_executionTimeInMS_95 / percentile_executionTimeInMS_50, toreal(0))\r\n//| where percentile_executionTimeInMS_90 > 500\r\n| where AvgExecutionTime > 0.5\r\n| project-rename Namespace=name, ExecutionTimeinMS_90=percentile_executionTimeInMS_95, ExecutionCount = NumOfTotalRequests, Depth=MaxDepth\r\n| project Namespace, ExecutionCount, AvgExecutionTime, percentile_executionTimeInMS_50, ExecutionTimeinMS_90, Depth\r\n| order by ExecutionTimeinMS_90 desc', parameters('tenantPluginNamespace'))]",
                                            "isOptional": true
                                        },
                                        {
                                            "name": "ControlType",
                                            "value": "FrameControlChart",
                                            "isOptional": true
                                        },
                                        {
                                            "name": "SpecificChart",
                                            "value": "StackedColumn",
                                            "isOptional": true
                                        },
                                        {
                                            "name": "PartTitle",
                                            "value": "Top plugins with high execution duration",
                                            "isOptional": true
                                        },
                                        {
                                            "name": "PartSubTitle",
                                            "value": "[parameters('appInsightsName')]",
                                            "isOptional": true
                                        },
                                        {
