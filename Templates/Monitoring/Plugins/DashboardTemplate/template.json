                                                            "aggregationType": 7,
                                                            "namespace": "microsoft.insights/components",
                                                            "metricVisualization": {
                                                                "displayName": "Server requests",
                                                                "resourceDisplayName": "[parameters('appInsightsName')]",
                                                                "color": "#0078D4"
                                                            }
                                                        }
                                                    ],
